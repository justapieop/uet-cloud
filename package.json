{
  "name": "kumo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:api": "tsc -b packages/domain packages/contracts packages/application packages/infrastructure packages/presentation apps/api",
    "build:db": "tsc -b packages/domain packages/application packages/infrastructure",
    "test:api": "npm run build:api && npm run typecheck:tests && node scripts/test-backend.mjs",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test:db": "npm run build:api && npm run typecheck:tests && node scripts/test-backend.mjs db",
    "seed:db": "npm run build:db && node --env-file-if-exists=.env scripts/seed-db.mjs",
    "admin:add": "npm run build:db && node --env-file-if-exists=.env scripts/add-admin.mjs",
    "start:api": "node apps/api/dist/main.js",
    "dev:api": "npm run build:api && node apps/api/dist/main.js | pino-pretty",
    "generate:api": "npm run generate -w packages/rest",
    "dev:web": "npm run -w apps/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "core-js@2.6.12": true
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "^16.4.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "dependencies": {
    "@azure/arm-network": "^39.1.0",
    "@azure/arm-storage": "^21.0.0",
    "@azure/core-rest-pipeline": "^1.25.0",
    "@nestjs/idempotency": "^0.0.2",
    "@nestjs/resilience": "^0.0.2"
  }
}
