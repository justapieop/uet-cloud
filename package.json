{
  "name": "kumo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:api": "tsc -b packages/domain packages/contracts packages/application packages/infrastructure packages/presentation apps/api",
    "start:api": "node apps/api/dist/main.js",
    "dev:api": "npm run build:api && npm run start:api"
  },
  "dependencies": {
    "@azure/app-configuration-provider": "^2.6.0",
    "@azure/identity": "^4.13.3",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/typeorm": "^12.0.1",
    "dotenv": "^18.0.3",
    "mssql": "^12.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
